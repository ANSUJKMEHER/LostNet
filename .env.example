# LostNet environment
# The data layer auto-selects:
#   - "local"  -> in-memory provider seeded from src/lib/seed.ts (no credentials needed)
#   - "sanity" -> Sanity Content Lake (requires the three vars below)
DATA_PROVIDER=local

# Only needed when DATA_PROVIDER=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Optional — AI narration (/api/narrate). Provide ONE of these; without a key
# the route silently returns the fact-built fallback sentence. The model only
# ever *describes* a pair the deterministic engine already matched.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NARRATE_MODEL=
